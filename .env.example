# Copy to .env and adjust. All values have working defaults; nothing here is required.

# SQLAlchemy database URL. Default: a SQLite file next to the app.
DEMO_API_DATABASE_URL=sqlite:///./demo_api.db

# Where extracted bundle files are stored on disk.
DEMO_API_STORAGE_DIR=storage

# Absolute base URL the server is reached at. Used to build the absolute URLs in
# /v1/models/index.json and /v1/models/check.
DEMO_API_PUBLIC_BASE_URL=http://localhost:8000

# PEM SubjectPublicKeyInfo Ed25519 public key used to verify SHA256SUMS.sig at
# publish time. Ships with a copy of the week-1 bundle signing public key.
DEMO_API_PINNED_PUBKEY_PATH=keys/bundle_signing_key_pub.pem

# When true, a bundle whose SHA256SUMS.sig does not verify against the pinned key
# is rejected (422). When false, it is accepted with signature_verified=false.
# A per-request ?allow_unsigned=true always downgrades a signature failure.
# File-digest mismatches are ALWAYS fatal regardless of this setting.
DEMO_API_REQUIRE_SIGNATURE=true

# When true, publishing the first bundle to a channel (or any publish with
# promote=true) sets it as the channel's latest.
DEMO_API_AUTO_PROMOTE_ON_PUBLISH=true

# Cache-Control max-age (seconds) for the mutable index.json / check responses.
DEMO_API_INDEX_CACHE_SECONDS=60

# Channels created automatically on first startup (JSON list).
DEMO_API_SEED_CHANNELS=["stable","beta"]
